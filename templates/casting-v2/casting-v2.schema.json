{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/freepass-creator/webtoon-studio/blob/main/assets/casting/v2/casting-v2.schema.json",
  "title": "Webtoon Studio Casting ABS v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "template",
    "candidate_code",
    "display_name",
    "role",
    "adult_age",
    "status",
    "canvas_px",
    "scale_px_per_cm",
    "grid_top_y_px",
    "floor_y_px",
    "height_cm",
    "body_height_px",
    "camera",
    "views",
    "pages",
    "identity_reference"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "template": { "const": "CASTING-ABS-v2.0" },
    "candidate_code": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]*-[0-9]{2}$" },
    "display_name": { "type": "string", "minLength": 1 },
    "role": { "type": "string", "minLength": 1 },
    "adult_age": { "type": "integer", "minimum": 18 },
    "status": { "$ref": "#/$defs/status" },
    "canvas_px": { "const": [2400, 3200] },
    "scale_px_per_cm": { "const": 10 },
    "grid_top_y_px": { "const": 410 },
    "floor_y_px": { "const": 2410 },
    "height_cm": { "type": "number", "minimum": 120, "maximum": 220 },
    "body_height_px": { "type": "number", "minimum": 1200, "maximum": 2200 },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": ["equivalent_focal_length_mm", "height_cm", "tilt_deg", "barefoot"],
      "properties": {
        "equivalent_focal_length_mm": { "type": "number", "minimum": 70, "maximum": 85 },
        "height_cm": { "const": 100 },
        "tilt_deg": { "const": 0 },
        "barefoot": { "const": true }
      }
    },
    "views": { "const": ["front", "exact-profile", "back"] },
    "pages": {
      "type": "object",
      "additionalProperties": false,
      "required": ["01_overview", "02_body_scale", "03_face_expression", "04_costume", "05_movement", "06_chemistry"],
      "properties": {
        "01_overview": { "$ref": "#/$defs/status" },
        "02_body_scale": { "$ref": "#/$defs/status" },
        "03_face_expression": { "$ref": "#/$defs/status" },
        "04_costume": { "$ref": "#/$defs/status" },
        "05_movement": { "$ref": "#/$defs/status" },
        "06_chemistry": { "$ref": "#/$defs/status" }
      }
    },
    "identity_reference": { "type": "string", "minLength": 1 },
    "notes": { "type": "string" }
  },
  "$defs": {
    "status": {
      "type": "string",
      "enum": ["not-made", "draft", "review", "revision", "passed", "locked"]
    }
  }
}
